# Which LLM drives the browser agent: anthropic | portkey | ollama
BROWSER_AGENT_LLM=anthropic

# Model name for anthropic and portkey
ANTHROPIC_MODEL=claude-opus-4-8

# BROWSER_AGENT_LLM=anthropic: direct Anthropic API
ANTHROPIC_API_KEY=

# BROWSER_AGENT_LLM=portkey: Anthropic models through the Portkey gateway
PORTKEY_API_KEY=
PORTKEY_BASE_URL=https://api.portkey.ai
PORTKEY_PROVIDER=@claude-code

# BROWSER_AGENT_LLM=ollama: local model in the ollama service (no key needed)
OLLAMA_MODEL=hermes3:8b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_NUM_CTX=16384

# Host ports (change if another app already uses them; services talk internally either way)
OPENWEBUI_PORT=3000
OLLAMA_PORT=11434
